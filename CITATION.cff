cff-version: 1.2.0
message: "If you use this dataset, please cite it as below."
title: "Japan Cannabinoid Trends Dataset 2026: Google Trends, Social Media, Regulatory Status, and Early Warning Index"
version: "1.11.0"
date-released: "2026-10-09"
type: dataset
license: CC-BY-4.0
language: ja

authors:
  - family-names: "KATO"
    given-names: "Kyoji"
    orcid: "https://orcid.org/0009-0007-5131-0374"
    affiliation: "Routeflags Co., Ltd."

keywords:
  - cannabinoid
  - CBD
  - THC
  - CBG
  - CBN
  - HHC
  - HHCH
  - THCH
  - THC-O
  - THCV
