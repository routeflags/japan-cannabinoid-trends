cff-version: 1.2.0
message: "If you use this dataset, please cite it as below."
title: "Japan Cannabinoid Platform Trends Dataset 2026: Google Trends and YouTube Evidence from Japan"
version: "1.13.2"
date-released: "2026-10-15"
type: dataset
license: CC-BY-4.0
language: ja

