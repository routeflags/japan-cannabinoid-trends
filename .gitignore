# Raw data — do not publish by default
**/data/raw/*
!**/data/raw/.gitkeep

# Exception: Google Trends raw data is public (see raw-data-policy.md §4.1)
!**/data/raw/google_trends/
!**/data/raw/google_trends/**

# Secrets
.env
.env.*
*.key

# macOS
.DS_Store

# Python
__pycache__/
.venv/
*.pyc
/.opencode/
/.serena

# .github (opencode symlink target)
.github/node_modules/
.github/package.json
.github/package-lock.json

/docs/plans

/.serena
/artifacts
/.opencode
/opencode.json
# Release archives
.release-archives/

# Private data (anonymization mappings, etc.)
datasets/*/data/private/

/datasets/youtube-consistency/schema/schema.sql