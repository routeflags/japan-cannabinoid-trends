# Raw data — do not publish by default
**/data/raw/*
!**/data/raw/.gitkeep

# Exception: Google Trends raw data is public (see raw-data-policy.md §4.1)
!**/data/raw/google_trends/
!**/data/raw/google_trends/**

# Secrets
.env
.env.*
# Explicit: skill docs (.github/skills/apify-*) keep machine-local tokens in
# .env.d/*.env (e.g. APIFY_TOKEN, chmod 600). Bare `.env.*` already matches the
# `.env.d` dirname, but spell it out so the rule survives pattern edits.
.env.d/*
# Re-include the dir itself (`.env.*` above matches the `.env.d` dirname,
# which would otherwise block all re-inclusions below it), then keep only
# templates committable (key names only, no values).
!.env.d/
!.env.d/*.example
*.key

# macOS
.DS_Store

# Python
__pycache__/
.venv/
*.pyc
*.egg-info/
.pytest_cache/
/.opencode/
/.serena

# .github (opencode symlink target)
.github/node_modules/
.github/package.json
.github/package-lock.json

/docs/plans

/.serena
/artifacts
/.opencode
/opencode.json
# Release archives
.release-archives/

# Local SQLite databases (research-local scratch stores such as trends.db).
# Reviewed 2026-10-13: zero *.db files are tracked (verified with git
# ls-files), so this rule cannot hide committed research data. The tracking
# inventory flags blanket patterns for periodic human review; this block is
# the reviewed exception (see validation-framework.md §19).
*.db
*.db-journal
*.db-wal
*.db-shm

# Private data (anonymization mappings, etc.)
datasets/*/data/private/
/tmp

# G1 collection pipeline work areas (G1 §13; provisional regulation - see
# docs/specs/collection-pipeline.md): staged runs and quarantined runs are
# local working data, never published; quarantine contents must not be
# redistributed before review.
.staging/
.quarantine/

# netloom VCR cassettes (recorded third-party round trips; see
# .github/skills/netloom/SKILL.md). They hold provider responses, session
# state, and query-string credentials (PSI/CRUX keys), so they are local
# evidence only: keep them here and never commit them.
.cassettes/

/.agents
