            }
          },
          {
            "name": "intent_id",
            "type": "string",
            "description": "投稿意図 ID (SKOS Concept notation)",
            "constraints": {
              "enum": [
                "intent_informational",
                "intent_commercial",
                "intent_experiential",
                "intent_harm_report",
                "unclassified"
              ]
            },
            "references": {
              "taxonomy": "metadata/taxonomy/content-taxonomy.skos.jsonld",
              "skos_scheme": "jptr:intent-scheme"
            }
          },
          {
            "name": "format_id",
            "type": "string",
            "description": "投稿形式 ID (SKOS Concept notation)",
            "constraints": {
              "enum": [
                "format_text",
                "format_image",
                "format_video",
                "format_link",
                "unclassified"
              ]
            },
            "references": {
              "taxonomy": "metadata/taxonomy/content-taxonomy.skos.jsonld",
              "skos_scheme": "jptr:format-scheme"
            }
          },
          {
            "name": "platform",
            "type": "string",
            "description": "プラットフォーム名",
            "constraints": {
              "enum": ["x_twitter"]
            },
            "references": {
              "schema_property": "schema:isPartOf",
              "schema_class": "schema:Platform"
            }
          },
          {
            "name": "language",
            "type": "string",
            "description": "言語コード (BCP 47)",
            "constraints": {
              "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
            },
            "references": {
              "schema_property": "schema:inLanguage"
            }
          }
        ]
      }
    },
    {
      "name": "cannabinoid-multi-trends",
      "path": "datasets/cannabinoid-multi-trends/",
      "format": "json,csv",
      "description": "主要カンナビノイド7化合物（CBD, THC, CBG, HHC, THCV, THC-O, THCH）のトレンドデータ（Google Trends, X, YouTube）",
      "schema": {
        "fields": [
          {
            "name": "keyword",
            "type": "string",
            "description": "収集キーワード（化合物名）",
            "constraints": {
              "enum": ["CBD", "THC", "CBG", "HHC", "THCV", "THC-O", "THCH"]
            }
          },
          {
            "name": "geo",
            "type": "string",
            "description": "地域コード (JP = 日本)",
            "constraints": {
              "enum": ["JP"]
            }
          },
          {
            "name": "timeframe",
            "type": "string",
            "description": "観測期間 (例: today 12-m, today 5-y)"
          },
          {
            "name": "source",
            "type": "string",
            "description": "データソース",
            "constraints": {
              "enum": ["google-trends", "x-twitter", "youtube"]
            }
          },
          {
            "name": "date",
            "type": "date",
            "description": "データポイントの日付 (週次データは週開始日)"
          },
          {
            "name": "value",
            "type": "number",
            "description": "興味度スコア (0-100, Google Trends)",
            "constraints": {
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "name": "record_count",
            "type": "integer",
            "description": "取得件数 (X, YouTube)",
            "constraints": {
              "minimum": 0
            }
          },
          {
            "name": "compound_category",
            "type": "string",
            "description": "化合物カテゴリ",
            "constraints": {
              "enum": [
                "major_phytocannabinoid",
                "minor_phytocannabinoid",
                "semi_synthetic",
                "synthetic"
              ]
            },
            "references": {
              "taxonomy": "metadata/taxonomy/compound-taxonomy.skos.jsonld",
              "skos_scheme": "jptr:compound-scheme"
            }
          }
        ]
      }
    }
  ],
  "doi": "10.5281/zenodo.23097769",
