  "@graph": [
    {
      "@id": "jptr:compound-taxonomy",
      "@type": "skos:ConceptScheme",
      "dct:title": [
        {
          "@value": "Cannabinoid Compound Taxonomy",
          "@language": "en"
        },
        {
          "@value": "カンナビノイド化合物タクソノミー",
          "@language": "ja"
        }
      ],
      "dct:description": {
        "@value": "Taxonomy of cannabinoid compounds tracked in this research project. Route/origin dimension; chemical class lives in a second dimension (jptr:chemical-class-taxonomy, owner decision (a) ISS-20261015-TAX-026). The scheme also carries one ADMINISTRATIVE registration-state category (jptr:compound-identity-unverified) for owner-named terms whose single-substance chemical identity is unverified; it states no route or chemical claim (ISS-20261111-TAX-040).",
        "@language": "en"
      },
      "dct:creator": "Routeflags Co., Ltd.",
      "dct:created": "2026-10-02",
      "dct:modified": "2026-11-15",
      "dct:license": "https://creativecommons.org/licenses/by/4.0/",
      "skos:hasTopConcept": [
        "jptr:compound-major",
        "jptr:compound-minor",
        "jptr:compound-rare",
        "jptr:compound-semisynthetic",
        "jptr:compound-synthetic",
        "jptr:compound-endocannabinoid",
        "jptr:compound-identity-unverified"
      ]
    },
