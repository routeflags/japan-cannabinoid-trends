        }
      ],
      "skos:notation": "compound_endocannabinoid",
      "skos:scopeNote": {
        "@value": "Endogenous signalling molecules of the endocannabinoid system: anandamide and 2-AG. Listed because they are described in the same literature, not because they are administered products.",
