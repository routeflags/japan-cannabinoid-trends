      "dct:title": [
        {
          "@value": "Cannabinoid Compound Taxonomy",
          "@language": "en"
        },
        {
          "@value": "カンナビノイド化合物タクソノミー",
          "@language": "ja"
        }
      ],
      "dct:description": {
        "@value": "Taxonomy of cannabinoid compounds tracked in this research project.",
        "@language": "en"
      },
      "dct:creator": "Routeflags Co., Ltd.",
      "dct:created": "2026-10-02",
      "dct:modified": "2026-10-13",
      "dct:license": "https://creativecommons.org/licenses/by/4.0/",
      "skos:hasTopConcept": [
        "jptr:compound-major",
        "jptr:compound-minor",
        "jptr:compound-rare",
        "jptr:compound-semisynthetic",
        "jptr:compound-synthetic",
        "jptr:compound-endocannabinoid"
      ]
    },
    {
      "@id": "jptr:compound-major",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Major Phytocannabinoids",
          "@language": "en"
        },
        {
          "@value": "主要フィトカンナビノイド",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_major",
      "skos:scopeNote": {
        "@value": "The phytocannabinoids that dominate research and market attention: CBD and THC.",
        "@language": "en"
      },
      "skos:narrower": [
        "jptr:compound-cbd",
        "jptr:compound-thc"
      ]
    },
    {
      "@id": "jptr:compound-minor",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Minor Phytocannabinoids",
          "@language": "en"
        },
        {
          "@value": "主要フィトカンナビノイド以外のフィトカンナビノイド",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_minor",
      "skos:scopeNote": {
        "@value": "Phytocannabinoids other than the major pair: CBG, CBN, CBC, THCV, CBDV, CBX and THCH.",
        "@language": "en"
      },
      "skos:narrower": [        "jptr:compound-cbg",
        "jptr:compound-cbn",
        "jptr:compound-cbc",
        "jptr:compound-thcv",
        "jptr:compound-cbdv",
        "jptr:compound-cbx",
        "jptr:compound-thch"
      ]
    },
    {
      "@id": "jptr:compound-rare",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Rare Cannabinoids",
          "@language": "en"
        },
        {
          "@value": "レアカンナビノイド",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_rare",
      "skos:scopeNote": {
        "@value": "Reserved for rare cannabinoids, i.e. the many phytocannabinoids found only in trace amounts (CBDP, THCP and similar). INTENTIONALLY EMPTY: no rare cannabinoid is registered as a concept yet, so this category records a dimension the taxonomy intends to cover rather than a gap or an oversight. Every other category lists its members in skos:narrower.",
        "@language": "en"
      }
    },
    {
      "@id": "jptr:compound-semisynthetic",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Semi-Synthetic Cannabinoids",
          "@language": "en"
        },
        {
          "@value": "半合成カンナビノイド",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_semisynthetic",
      "skos:scopeNote": {
        "@value": "Cannabinoids obtained by chemically modifying a natural cannabinoid: HHC, THC-O, H4CBH and HHBD. Classified by production route, which is why HHC sits here although it is also a hydrogenated cannabinoid.",
        "@language": "en"
      },
      "skos:narrower": [        "jptr:compound-hhc",
        "jptr:compound-thc-o",
        "jptr:compound-h4cbh",
        "jptr:compound-hhbd"
      ]
    },
    {
      "@id": "jptr:compound-synthetic",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Synthetic Cannabinoids",
          "@language": "en"
        },
        {
          "@value": "合成カンナビノイド",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_synthetic",
      "skos:scopeNote": {
        "@value": "Cannabinoids with no natural counterpart: HHCH, CRDP and CRDH.",
        "@language": "en"
      },
      "skos:narrower": [        "jptr:compound-hhch",
        "jptr:compound-crdp",
        "jptr:compound-crdh"
      ]
    },
    {
      "@id": "jptr:compound-endocannabinoid",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
