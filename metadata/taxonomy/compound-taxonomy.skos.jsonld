  },
  "@graph": [
    {
      "@id": "jptr:compound-taxonomy",
      "@type": "skos:ConceptScheme",
      "dct:title": [
        {
          "@value": "Cannabinoid Compound Taxonomy",
          "@language": "en"
        },
        {
          "@value": "カンナビノイド化合物タクソノミー",
          "@language": "ja"
        }
      ],
      "dct:description": {
        "@value": "Taxonomy of cannabinoid compounds tracked in this research project. Route/origin dimension; chemical class lives in a second dimension (jptr:chemical-class-taxonomy, owner decision (a) ISS-20261015-TAX-026). The scheme also carries one ADMINISTRATIVE registration-state category (jptr:compound-identity-unverified) for owner-named terms whose chemical identity is unverified; it states no route or chemical claim (ISS-20261111-TAX-040).",
        "@language": "en"
      },
      "dct:creator": "Routeflags Co., Ltd.",
      "dct:created": "2026-10-02",
      "dct:modified": "2026-11-11",
      "dct:license": "https://creativecommons.org/licenses/by/4.0/",
      "skos:hasTopConcept": [
        "jptr:compound-major",
        "jptr:compound-minor",
        "jptr:compound-rare",
        "jptr:compound-semisynthetic",
        "jptr:compound-synthetic",
        "jptr:compound-endocannabinoid",
        "jptr:compound-identity-unverified"
      ]
    },
    {
      "@id": "jptr:compound-major",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Major Phytocannabinoids",
          "@language": "en"
        },
        {
          "@value": "主要フィトカンナビノイド",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_major",
      "skos:scopeNote": {
        "@value": "The phytocannabinoids that dominate research and market attention: CBD and THC.",
        "@language": "en"
      },
      "skos:narrower": [
        "jptr:compound-cbd",
        "jptr:compound-thc"
      ]
    },
    {
      "@id": "jptr:compound-minor",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Minor Phytocannabinoids",
          "@language": "en"
        },
        {
          "@value": "主要フィトカンナビノイド以外のフィトカンナビノイド",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_minor",
      "skos:scopeNote": {
        "@value": "Phytocannabinoids other than the major pair: CBG, CBN, CBC, THCV, CBDV, CBX and THCH.",
        "@language": "en"
      },
      "skos:narrower": [        "jptr:compound-cbg",
        "jptr:compound-cbn",
        "jptr:compound-cbc",
        "jptr:compound-thcv",
        "jptr:compound-cbdv",
        "jptr:compound-cbx",
        "jptr:compound-thch"
      ]
    },
    {
      "@id": "jptr:compound-rare",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Rare Cannabinoids",
          "@language": "en"
        },
        {
          "@value": "レアカンナビノイド",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_rare",
      "skos:scopeNote": {
        "@value": "Reserved for rare cannabinoids, i.e. the many phytocannabinoids found only in trace amounts (CBDP, THCP and similar). INTENTIONALLY EMPTY: no rare cannabinoid is registered as a concept yet, so this category records a dimension the taxonomy intends to cover rather than a gap or an oversight. Every other category lists its members in skos:narrower.",
        "@language": "en"
      }
    },
    {
      "@id": "jptr:compound-semisynthetic",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Semi-Synthetic Cannabinoids",
          "@language": "en"
        },
        {
          "@value": "半合成カンナビノイド",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_semisynthetic",
      "skos:scopeNote": {
        "@value": "Cannabinoids obtained by chemically modifying a natural cannabinoid: HHC, THC-O, H4CBH, HHBD and THCNM. Classified by production route, which is why HHC sits here although it is also a hydrogenated cannabinoid. Chemical class is a separate dimension (jptr:chemical-class-taxonomy): HHC, H4CBH and HHBD are chemclass_hydrogenated, THC-O is chemclass_acetate, and THCNM has no formalized chemical class. THCNM's placement is provisional: both market-reported identities describe a substituted derivative of a phytocannabinoid, but the identity itself is unconfirmed (see its scopeNote).",
        "@language": "en"
      },
      "skos:narrower": [        "jptr:compound-hhc",
        "jptr:compound-thc-o",
        "jptr:compound-h4cbh",
        "jptr:compound-hhbd",
        "jptr:compound-thcnm"
      ]
    },
    {
      "@id": "jptr:compound-synthetic",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Synthetic Cannabinoids",
          "@language": "en"
        },
        {
          "@value": "合成カンナビノイド",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_synthetic",
      "skos:scopeNote": {
        "@value": "Cannabinoids with no natural counterpart: HHCH, CRDP and CRDH.",
        "@language": "en"
      },
      "skos:narrower": [        "jptr:compound-hhch",
        "jptr:compound-crdp",
        "jptr:compound-crdh"
      ]
    },
    {
      "@id": "jptr:compound-endocannabinoid",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Endocannabinoids",
          "@language": "en"
        },
        {
          "@value": "エンドカンナビノイド",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_endocannabinoid",
      "skos:scopeNote": {
        "@value": "Endogenous signalling molecules of the endocannabinoid system: anandamide and 2-AG. Listed because they are described in the same literature, not because they are administered products.",
        "@language": "en"
      },
      "skos:narrower": [        "jptr:compound-anandamide",
        "jptr:compound-2ag"
      ]
    },
    {
      "@id": "jptr:compound-identity-unverified",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:topConceptOf": "jptr:compound-taxonomy",
      "skos:prefLabel": [
        {
          "@value": "Identity-Unverified Registered Terms (registration state)",
          "@language": "en"
        },
        {
          "@value": "同一性未確認の登録語（登録状態）",
          "@language": "ja"
        }
      ],
      "skos:notation": "compound_identity_unverified",
      "skos:scopeNote": [
        {
          "@value": "An ADMINISTRATIVE registration-state category, not a route/origin or chemical classification. Its members are search terms the owner named for this study whose chemical identity is UNCONFIRMED in this repository. Placing a term here records only that the string is registered and queryable: it makes no claim about route or origin, natural occurrence, chemical class, structure, synonym relationships or regulatory status, and it neither asserts that the term names a distinct substance nor that a substance behind the string exists. Membership is not a judgement that a term is rare, minor, semi-synthetic or synthetic, and it never substitutes for one of those categories; when evidence arrives, move the term to the category that evidence supports. Members carry no skos:exactMatch, CAS number, PubChem or IUPAC name and no chemical-class link until an identifier is verified. A term is registered here because the owner named it, not because its identity was established. Decision record: ISS-20261111-TAX-040, which supersedes the ISS-20261015-TAX-027 non-registration decision for THCP.",
          "@language": "en"
        },
        {
          "@value": "経路・由来や化学分類ではなく、**管理上の登録状態**カテゴリ。members は owner が本研究のために名指しした検索語のうち、リポジトリ内で化学的同一性が**未確認**のものである。ここに置くことは「その文字列を登録し照会可能にした」ことだけを記録する。経路・由来、天然存在、化学クラス、構造、別名関係、規制状態について何も主張せず、語が別個の物質を指すことや、文字列の背後に物質が存在することの主張でもない。希少・マイナー・半合成・合成のいずれかであるという判断でもなく、これらのカテゴリの代替にもならない。根拠が得られたら、その根拠が支えるカテゴリへ移す。識別子が検証されるまで `skos:exactMatch`・CAS 番号・PubChem / IUPAC 名・化学クラスへのリンクを付けない。ここへの登録は owner が語を名指ししたことが理由であり、同一性が確定したことが理由ではない。決定記録: ISS-20261111-TAX-040（THCP については ISS-20261015-TAX-027 の非登録判断を置換）。",
          "@language": "ja"
        }
      ],
      "skos:narrower": [
        "jptr:compound-thcb",
        "jptr:compound-thcp",
        "jptr:compound-thcjd",
        "jptr:compound-thcpo",
