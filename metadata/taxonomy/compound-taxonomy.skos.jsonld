    {
      "@id": "jptr:compound-thcnm",
      "@type": "skos:Concept",
      "skos:inScheme": "jptr:compound-taxonomy",
      "skos:broader": "jptr:compound-semisynthetic",
      "skos:prefLabel": [
        {
          "@value": "THCNM",
