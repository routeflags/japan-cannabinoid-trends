{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "instructions": [
    ".github/copilot-instructions.md",
    ".github/agents/*.agent.md",
    ".github/skills/*/SKILL.md"
  ],
  "permission": {
    "*": "allow"
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "providers": {
    "vllm": {
      "settings": {
        "baseURL": "http://100.82.6.111:8000/v1"
      }
    }
  },
  "provider": {
    "qwen-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qwen Coder (Mac mini)",
      "options": {
        "baseURL": "http://100.82.6.111:8000/v1"
      },
      "models": {
        "Qwen/Qwen2.5-Coder-7B-Instruct": {
          "name": "Qwen2.5 Coder 7B",
          "limit": {
            "context": 120000,
            "output": 8192
          }
        }
      }
    },

    "oxcoder-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OxCoder (Mac mini)",
      "options": {
        "baseURL": "http://100.82.6.111:8000/v1"
      },
