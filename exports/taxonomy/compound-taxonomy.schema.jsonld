      "schema:name": "Major Phytocannabinoids",
      "schema:inDefinedTermSet": {
        "@type": "schema:DefinedTermSet",
        "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound-major-scheme"
      },
      "schema:alternateName": "主要フィトカンナビノイド",
      "schema:description": "The phytocannabinoids that dominate research and market attention: CBD and THC.",
      "schema:termCode": "compound_major"
    },
    {
      "@type": "schema:DefinedTerm",
      "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound_minor",
      "schema:name": "Minor Phytocannabinoids",
      "schema:inDefinedTermSet": {
        "@type": "schema:DefinedTermSet",
        "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound-minor-scheme"
      },
      "schema:alternateName": "主要フィトカンナビノイド以外のフィトカンナビノイド",
      "schema:description": "Phytocannabinoids other than the major pair: CBG, CBN, CBC, THCV, CBDV, CBX and THCH.",
      "schema:termCode": "compound_minor"
    },
    {
      "@type": "schema:DefinedTerm",
      "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound_rare",
      "schema:name": "Rare Cannabinoids",
      "schema:inDefinedTermSet": {
        "@type": "schema:DefinedTermSet",
        "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound-rare-scheme"
      },
      "schema:alternateName": "レアカンナビノイド",
      "schema:description": "Reserved for rare cannabinoids, i.e. the many phytocannabinoids found only in trace amounts (CBDP, THCP and similar). INTENTIONALLY EMPTY: no rare cannabinoid is registered as a concept yet, so this category records a dimension the taxonomy intends to cover rather than a gap or an oversight. Every other category lists its members in skos:narrower.",
      "schema:termCode": "compound_rare"
    },
    {
      "@type": "schema:DefinedTerm",
      "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound_semisynthetic",
      "schema:name": "Semi-Synthetic Cannabinoids",
      "schema:inDefinedTermSet": {
        "@type": "schema:DefinedTermSet",
        "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound-semisynthetic-scheme"
      },
      "schema:alternateName": "半合成カンナビノイド",
      "schema:description": "Cannabinoids obtained by chemically modifying a natural cannabinoid: HHC, THC-O, H4CBH and HHBD. Classified by production route, which is why HHC sits here although it is also a hydrogenated cannabinoid. Chemical class is a separate dimension (jptr:chemical-class-taxonomy): HHC, H4CBH and HHBD are chemclass_hydrogenated, THC-O is chemclass_acetate.",
      "schema:termCode": "compound_semisynthetic"
    },
    {
