      "@type": "schema:DefinedTerm",
      "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound_cbga",
      "schema:name": "Cannabigerolic acid (CBGA)",
      "schema:inDefinedTermSet": {
