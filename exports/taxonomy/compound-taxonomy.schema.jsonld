    {
      "@type": "schema:DefinedTerm",
      "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound_identity_unverified",
      "schema:name": "Identity-Unverified Registered Terms (registration state)",
      "schema:inDefinedTermSet": {
        "@type": "schema:DefinedTermSet",
        "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound-identity-unverified-scheme"
      },
      "schema:alternateName": "同一性未確認の登録語（登録状態）",
      "schema:description": "An ADMINISTRATIVE registration-state category, not a route/origin or chemical classification. Its members are search terms the owner named for this study whose chemical identity is UNCONFIRMED in this repository. Placing a term here records only that the string is registered and queryable: it makes no claim about route or origin, natural occurrence, chemical class, structure, synonym relationships or regulatory status, and it neither asserts that the term names a distinct substance nor that a substance behind the string exists. Membership is not a judgement that a term is rare, minor, semi-synthetic or synthetic, and it never substitutes for one of those categories; when evidence arrives, move the term to the category that evidence supports. Members carry no skos:exactMatch, CAS number, PubChem or IUPAC name and no chemical-class link until an identifier is verified. A term is registered here because the owner named it, not because its identity was established. Decision record: ISS-20261111-TAX-040, which supersedes the ISS-20261015-TAX-027 non-registration decision for THCP.",
      "schema:termCode": "compound_identity_unverified"
    },
