    {
      "@type": "schema:DefinedTerm",
      "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound_thcv",
      "schema:name": "Tetrahydrocannabivarin (THCV)",
      "schema:inDefinedTermSet": {
        "@type": "schema:DefinedTermSet",
        "@id": "https://japan-cannabinoid-trends.routeflags.com/taxonomy/compound-thcv-scheme"
      },
      "schema:alternateName": [
        "テトラヒドロカンナビバリン (THCV)",
        "THCV",
        "THCv"
      ],
      "schema:description": "No skos:exactMatch is asserted: this concept leaves the Δ8/Δ9 positional isomer and the stereochemistry unspecified, while every verified registry record is more specific. CHEBI:755032 and Wikidata Q76009679 denote a stereo-defined Δ9-THCV, and Wikidata Q254768 denotes Δ9-THCV with the stereochemistry unspecified; none denotes an isomer-unspecified THCV, so attaching one would assert Δ9. The records, their identifiers and the open mapping scope are documented in docs/provenance/compound-taxonomy.md (ISS-20261115-TAX-043). This note states no chemical identity for any query result.",
      "schema:termCode": "compound_thcv"
    },
