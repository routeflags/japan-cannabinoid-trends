    "sourceUrl": "https://www.ncd.mhlw.go.jp/dl_data/keitai/cotrolled_substances_list20241212%20.pdf",
    "knowledgeGraph": "metadata/taxonomy/thc-regulatory-knowledge-graph.json",
    "internationalTreatyStatus": {
      "delta9THC": {
