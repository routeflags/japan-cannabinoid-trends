    "created": "2026-09-18",
    "updated": "2026-10-09",
    "maintainer": "ROUTE FLAGS Co., Ltd."
  },

  "queryDesign": {
    "lastUpdated": "2026-10-09",
    "principle": "MECE: Each compound has unique queries per media type, avoiding overlap",

    "mediaTypes": {
      "x": {
        "languageFilter": "lang:ja",
        "queryFormat": "{compound} リキッド",
        "actor": "cPYLH3QT9GyzKhB4S",
        "costPerCompound": "~$0.10"
      },
      "youtube": {
        "languageFilter": null,
        "queryFormat": "{compound} リキッド",
        "actor": "gJvjeCYNraSfhIaNd",
        "costPerCompound": "~$0.05",
        "note": "No language filter available. Japanese queries preferred to surface Japanese content."
      },
      "googleTrends": {
        "queryFormat": "{compound}",
        "mcp": "google-trends",
        "costPerCompound": "free"
      }
    },

    "compounds": {
      "CBD": {
        "japaneseName": "カンナビジオール",
        "aliases": [],
        "queries": {
          "x": "CBD リキッド lang:ja",
          "youtube": "CBD リキッド",
          "googleTrends": "CBD"
        },
        "commonScaleSet": "Set A"
      },
      "THC": {
        "japaneseName": "テトラヒドロカンナビノール",
