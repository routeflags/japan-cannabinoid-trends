# Template for `.env.d/apify.env` (see `.github/skills/apify-mcp/SKILL.md`).
# Key names only -- no values. Copy to `.env.d/apify.env`, fill in your own
# token from https://console.apify.com/settings/integrations, then run:
#   chmod 600 .env.d/apify.env
# Never commit the filled-in file (it stays gitignored).
APIFY_TOKEN=
# Optional: TOOLS=actors,docs,apify/rag-web-browser
# Optional: TELEMETRY_ENABLED=false
