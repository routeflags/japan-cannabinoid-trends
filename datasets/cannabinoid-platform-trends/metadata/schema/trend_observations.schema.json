{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routeflags.github.io/japan-cannabinoid-trends/schema/cannabinoid-platform-trends/trend_observations.schema.json",
  "title": "cannabinoid-platform-trends trend observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "compound",
    "compound_id",
    "platform",
    "source",
    "metric",
    "unit",
    "period_start",
    "period_end",
    "granularity",
    "value",
    "status",
    "query_id",
    "query_text",
    "run_id",
    "collection_method",
    "observation_scope",
    "provenance_ref",
    "limitations"
  ],
  "properties": {
    "observation_id": {"type": "string"},
    "compound": {"type": "string"},
    "compound_id": {"type": "string"},
    "platform": {"enum": ["google_trends", "youtube"]},
    "source": {"type": "string"},
    "metric": {"type": "string"},
    "unit": {"type": "string"},
    "period_start": {"type": "string"},
    "period_end": {"type": "string"},
    "granularity": {"type": "string"},
    "value": {"type": "string"},
    "status": {"enum": ["observed_zero", "observed_nonzero", "missing"]},
    "query_id": {"type": "string"},
    "query_text": {"type": "string"},
    "run_id": {"type": "string"},
    "collection_method": {"type": "string"},
    "observation_scope": {"type": "string"},
    "provenance_ref": {"type": "string"},
    "limitations": {"type": "string"}
  }
}
