#!/usr/bin/env bash
# =============================================================================
# Pre-commit hook: Data Schema + Version Sync + Research Pages + Emergence Tracker + Processed Artifact + X Identity Validation
#
# コミット前に以下を検証:
# 1. Data Dictionary と実際のデータスキーマの一致
# 2. バージョン/DOI の同期（CITATION.cff, datapackage.json 等）
# 3. 調査ページの完全性（publication/research_*.html）
# 4. Search Emergence Tracker の最新性（publication/search-emergence-tracker）
# 5. processed 成果物の再現性（再導出可能、または欠落入力を明示した再現不能宣言）
# 6. X 識別情報の混入防止（投稿本文・handle・表示名・投稿 URL を追跡しない）
#
# 検証をスキップする場合:
#   git commit --no-verify
#
# フックを無効化する場合:
#   mv .git/hooks/pre-commit .git/hooks/pre-commit.disabled
# =============================================================================

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# 変更されたファイルを取得
CHANGED_FILES=$(git diff --cached --name-only)

# データスキーマ検証が必要なファイル
SCHEMA_VALIDATION_NEEDED=false

# バージョン同期検証が必要なファイル
VERSION_VALIDATION_NEEDED=false

# 調査ページ完全性検証が必要なファイル
RESEARCH_VALIDATION_NEEDED=false

# Emergence Tracker 検証が必要なファイル
EMERGENCE_VALIDATION_NEEDED=false

# processed 成果物の再現性検証が必要なファイル
PROCESSED_AUDIT_NEEDED=false

# X 識別情報の混入防止検証が必要なファイル
X_IDENTITY_AUDIT_NEEDED=false

# 検証は独立している（例: processed CSV の変更はスキーマと再現性の両方に効く）
# ため、case は 1 本にまとめず検証ごとに独立させる。1 本の case では最初に一致した
# 分岐しか実行されず、後段のゲートが黙って走らなくなる。
for file in $CHANGED_FILES; do
  # 1. データスキーマ検証対象
  case $file in
    metadata/datapackage.json|\
    datasets/*/data/processed/*.csv|\
    docs/data-dictionary.md|\
    docs/provenance.md)
      SCHEMA_VALIDATION_NEEDED=true
      ;;
  esac

  # 2. バージョン同期検証対象
  case $file in
    CITATION.cff|\
    CHANGELOG.md|\
    metadata/datapackage.json|\
    methodology.md|\
    README.md|\
    publication/guide_cbx_rewrite.html)
      VERSION_VALIDATION_NEEDED=true
      ;;
  esac

  # 3. 調査ページ完全性検証対象（全 study の主要 raw 種別。google_trends 例外の
  # 追跡 raw を含む。将来の study・source 追加時はここに種別を足す）
  case $file in
    publication/research_*.html|\
    datasets/*/data/raw/x/*|\
    datasets/*/data/raw/youtube/*|\
    datasets/*/data/raw/google_trends/*|\
    datasets/*/data/raw/coa/*)
      RESEARCH_VALIDATION_NEEDED=true
      ;;
  esac

  # 4. Emergence Tracker 検証対象
  case $file in
    publication/search-emergence-tracker/*|\
    project.json|\
    research/regulatory-status/*)
      EMERGENCE_VALIDATION_NEEDED=true
      ;;
  esac

  # 5. processed 成果物の再現性検証対象（成果物・導出規則・規則仕様のいずれが変わっても再検証）
  case $file in
    datasets/*/data/processed/*|\
    src/processing/*|\
    metadata/taxonomy/classification-rules.yaml)
      PROCESSED_AUDIT_NEEDED=true
      ;;
  esac

  # 6. X 識別情報の混入防止検証対象（データ・公開成果物・検査規則のいずれが変わっても再検証）
  case $file in
    datasets/*/data/*|\
    publication/*|\
    src/validation/x_identity.py|\
    metadata/privacy/*)
      X_IDENTITY_AUDIT_NEEDED=true
      ;;
  esac
done

# いずれの検証も不要な場合はスキップ
if [ "$SCHEMA_VALIDATION_NEEDED" = false ] && [ "$VERSION_VALIDATION_NEEDED" = false ] && [ "$RESEARCH_VALIDATION_NEEDED" = false ] && [ "$EMERGENCE_VALIDATION_NEEDED" = false ] && [ "$PROCESSED_AUDIT_NEEDED" = false ] && [ "$X_IDENTITY_AUDIT_NEEDED" = false ]; then
  exit 0
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Pre-commit: Data Validation"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

VALIDATION_FAILED=false

# 1. データスキーマ検証
if [ "$SCHEMA_VALIDATION_NEEDED" = true ]; then
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  1. Data Schema Validation"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  
  if ! bash scripts/validation/validate-data-schema.sh; then
    echo ""
    echo "  ❌ データスキーマ検証に失敗しました"
    VALIDATION_FAILED=true
  else
    echo ""
    echo "  ✅ データスキーマ検証に合格しました"
  fi
  echo ""
fi

# 2. バージョン同期検証
if [ "$VERSION_VALIDATION_NEEDED" = true ]; then
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  2. Version Sync Validation"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  
  if ! bash scripts/validation/validate-version-sync.sh; then
    echo ""
    echo "  ❌ バージョン同期検証に失敗しました"
    VALIDATION_FAILED=true
  else
    echo ""
    echo "  ✅ バージョン同期検証に合格しました"
  fi
  echo ""
fi

# 3. 調査ページ完全性検証
if [ "$RESEARCH_VALIDATION_NEEDED" = true ]; then
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  3. Research Pages Validation"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  
  if ! python3 scripts/validation/validate-research-pages.py; then
    echo ""
    echo "  ❌ 調査ページ完全性検証に失敗しました"
    VALIDATION_FAILED=true
  else
    echo ""
    echo "  ✅ 調査ページ完全性検証に合格しました"
  fi
  echo ""
fi

# 4. Emergence Tracker 検証
if [ "$EMERGENCE_VALIDATION_NEEDED" = true ]; then
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  4. Search Emergence Tracker Validation"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  
  if ! bash scripts/validation/validate-search-emergence-tracker.sh; then
    echo ""
    echo "  ❌ Emergence Tracker 検証に失敗しました"
    VALIDATION_FAILED=true
  else
    echo ""
    echo "  ✅ Emergence Tracker 検証に合格しました"
  fi
  echo ""
fi

# 5. processed 成果物の再現性検証
if [ "$PROCESSED_AUDIT_NEEDED" = true ]; then
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  5. Processed Artifact Reproducibility"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""

  # 検証は標準ライブラリのみで動く（cerberus 不要）ため、venv が無い環境でも実行できる。
  if ! PYTHONPATH=src python3 -m processing.cli audit-processed; then
    echo ""
    echo "  ❌ processed 成果物の再現性検証に失敗しました"
    VALIDATION_FAILED=true
  else
    echo ""
    echo "  ✅ processed 成果物の再現性検証に合格しました"
  fi
  echo ""
fi

# 6. X 識別情報の混入防止検証
if [ "$X_IDENTITY_AUDIT_NEEDED" = true ]; then
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  6. X Identity Exposure"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""

  # 検証は標準ライブラリのみで動く（cerberus 不要の専用入口）ため、venv が無い環境でも実行できる。
  if ! PYTHONPATH=src python3 -m validation.x_identity; then
    echo ""
    echo "  ❌ X 識別情報の混入防止検証に失敗しました"
    VALIDATION_FAILED=true
  else
    echo ""
    echo "  ✅ X 識別情報の混入防止検証に合格しました"
  fi
  echo ""
fi

# 検証結果の判定
if [ "$VALIDATION_FAILED" = true ]; then
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  ❌ コミットがブロックされました"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "  検証に失敗しました。問題を修正するか、--no-verify でスキップしてください。"
  echo ""
  exit 1
fi

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  ✅ 全検証に合格しました"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

exit 0
